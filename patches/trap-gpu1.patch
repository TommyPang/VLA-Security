+def _traj_context_for_action(
+    input_ids: torch.Tensor,
+    hidden_states: torch.Tensor,
+    lm_head: torch.nn.Module,
+    cot_labels: torch.Tensor,
+    *,
+    ss_prob: float = 1.0,
+) -> torch.Tensor:
+    """Replace GT traj tokens with greedy model predictions (detached) for action CE.
+
+    Cot loss still uses the teacher-forced forward. Action loss should see the traj the
+    model actually emits under the patched image — closer to closed-loop AR.
+    ``ss_prob`` is the per-sample probability of using predicted traj (scheduled sampling).
+    Returns ``input_ids`` unchanged when no sample needs replacement.
+    """
+    if ss_prob <= 0.0:
+        return input_ids
+    batch_size = input_ids.shape[0]
+    replace_mask = torch.rand(batch_size, device=input_ids.device) < ss_prob
+    if not bool(replace_mask.any()):
+        return input_ids
+    out = input_ids.clone()
+    with torch.no_grad():
+        for b in range(batch_size):
+            if not bool(replace_mask[b]):
+                continue
+            traj_pos = cot_labels[b].ne(-100).nonzero(as_tuple=False).flatten()
+            if traj_pos.numel() == 0:
+                continue
+            # Next-token: label at t is predicted from hidden[t - 1].
+            prev = traj_pos - 1
+            if bool((prev < 0).any()):
+                continue
+            logits = lm_head(hidden_states[b, prev, :])
+            pred = logits.argmax(dim=-1).to(dtype=out.dtype)
+            out[b, traj_pos] = pred
+    return out
+
+
