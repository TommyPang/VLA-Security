+def _normalized_difference_roi(before: np.ndarray, after: np.ndarray):
+    changed = np.any(before != after, axis=-1)
+    ys, xs = np.nonzero(changed)
+    if xs.size == 0:
+        return None
+    height, width = changed.shape
+    # x1/y1 are exclusive so a one-pixel region remains non-empty.
+    return (
+        float(xs.min() / width),
+        float(ys.min() / height),
+        float((xs.max() + 1) / width),
+        float((ys.max() + 1) / height),
+    )
+
+
+def _mask_changed_region(image: np.ndarray, changed_from: np.ndarray) -> np.ndarray:
+    """Cover the complete rendered sign footprint with a neutral local colour."""
+    changed = np.any(image != changed_from, axis=-1)
+    ys, xs = np.nonzero(changed)
+    if xs.size == 0:
+        return image
+    y0, y1 = int(ys.min()), int(ys.max()) + 1
+    x0, x1 = int(xs.min()), int(xs.max()) + 1
+    border = max(2, min(image.shape[:2]) // 64)
+    sample = changed_from[
+        max(0, y0 - border) : min(image.shape[0], y1 + border),
+        max(0, x0 - border) : min(image.shape[1], x1 + border),
+    ]
+    colour = np.median(sample.reshape(-1, sample.shape[-1]), axis=0).astype(image.dtype)
+    masked = image.copy()
+    masked[y0:y1, x0:x1] = colour
+    return masked
 
 
